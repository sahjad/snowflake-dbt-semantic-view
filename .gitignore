# ============================================================
# dbt-generated artifacts
# These are regenerated by dbt and should not be committed.
# ============================================================

**/target/
**/dbt_packages/
**/logs/
**/.user.yml

# Local dbt profile can contain account credentials.
**/profiles.yml

# Local dbt configuration directory.
**/.dbt/


# ============================================================
# Python-generated artifacts and virtual environments
# ============================================================

**/__pycache__/
*.py[cod]
*$py.class

**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

.coverage
.coverage.*
htmlcov/

**/.venv/
**/venv/

*.egg-info/


# ============================================================
# Node / Cytoscape frontend dependencies and caches
# ============================================================

**/node_modules/
**/.npm/
**/.pnpm-store/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ============================================================
# Streamlit secrets
#
# Keep .streamlit/config.toml in Git.
# Ignore only secrets.toml.
# ============================================================

**/.streamlit/secrets.toml


# ============================================================
# Local environment files and credentials
# ============================================================

.env
.env.*
!.env.example
!*.env.example

# Snowflake/private-key authentication files.
*.p8
*.pem
*.key


# ============================================================
# Temporary and log files
# ============================================================

*.log
*.tmp
*.temp
*.bak
*~


# ============================================================
# Operating system files
# ============================================================

.DS_Store
Thumbs.db
Desktop.ini


# ============================================================
# Editor and IDE files
# ============================================================

*.swp
*.swo

.vscode/
.idea/
.vs/